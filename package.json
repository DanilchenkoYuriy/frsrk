{
  "name": "frsrk-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Официальный сайт Федерации роуп скиппинга (спортивной скакалки) Республики Крым",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:prod": "tsx --env-file=.env.prod scripts/seed.ts",
    "update-docs": "tsx --env-file=.env scripts/update-documents-2026-09.ts",
    "update-docs:prod": "tsx --env-file=.env.prod scripts/update-documents-2026-09.ts",
    "images:optimize": "tsx scripts/prepare-assets.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bad-script": "^5.3.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "^16.8.1",
    "next": "^16.3.6",
    "payload": "3.90.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "dompurify": "^3.4.13"
  }
}
