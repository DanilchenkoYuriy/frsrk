# ─────────────────────────────────────────────────────────────
# ФРСРК v3 — переменные окружения.
# Скопируйте этот файл в .env и заполните. Файл .env НИКОГДА
# не отправляйте в GitHub (он уже в .gitignore).
# На хостинге Timeweb эти же значения вводятся в настройках приложения.
# ─────────────────────────────────────────────────────────────

# Адрес сайта (с https://, без слэша на конце)
NEXT_PUBLIC_SITE_URL=https://ваш-домен.ru

# База данных PostgreSQL (Timeweb → Базы данных → Подключение)
DATABASE_URL=postgresql://пользователь:пароль@хост:5432/имя_базы
# Если при запуске ошибка про SSL или сертификат, добавьте строку: DATABASE_SSL=no-verify
# DATABASE_SSL=no-verify

# Другие адреса сайта через запятую (например, версия с www). Не обязательно.
# EXTRA_ORIGINS=https://www.ваш-домен.ru

# Код подтверждения сайта в Яндекс.Вебмастере. Не обязательно.
# YANDEX_VERIFICATION=

# Секрет для входа в админку: любая случайная строка от 32 символов
PAYLOAD_SECRET=замените-на-длинную-случайную-строку-минимум-32-символа

# Файловое хранилище S3 (Timeweb → Хранилище S3). Без него файлы
# кладутся в локальную папку storage/ — на хостинге так делать нельзя.
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=имя-бакета
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес бакета: https://s3.twcstorage.ru/имя-бакета
S3_PUBLIC_URL=https://s3.twcstorage.ru/имя-бакета

# Почта для писем (сброс пароля, уведомления с формы). Не обязательно.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
