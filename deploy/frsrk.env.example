# Скопируйте в deploy/frsrk.env на сервере. Значения S3, PAYLOAD_SECRET и SMTP
# переносятся из настроек приложения в Timeweb без изменений (S3 меняется, если файлы переезжают в хранилище FirstVDS).
NEXT_PUBLIC_SITE_URL=https://frsrk.ru
EXTRA_ORIGINS=https://www.frsrk.ru
# Пароль тот же, что POSTGRES_PASSWORD в deploy/.env
DATABASE_URL=postgresql://postgres:ПАРОЛЬ@postgres:5432/frsrk
PAYLOAD_SECRET=
YANDEX_VERIFICATION=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
